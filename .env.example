# токен бота от @BotFather
BOT_TOKEN=
# api_id и api_hash с my.telegram.org (нужны локальному серверу Bot API)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# канал, на который нужно быть подписанным: -100… или @username
CHANNEL_ID=
# ссылка на канал для кнопки «Подписаться»
CHANNEL_URL=
# Telegram id администраторов (узнать у @userinfobot); несколько — через запятую
ADMIN_IDS=
# предел размера файла, МБ (пусто — 200)
MAX_FILE_MB=
# предел длительности видео, секунд (пусто — 180)
MAX_DURATION_SEC=
# предел времени одного рендера, секунд (пусто — 900)
RENDER_TIMEOUT_SEC=
